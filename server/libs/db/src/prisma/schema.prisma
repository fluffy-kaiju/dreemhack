generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}


enum EJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}


model User {
  id       String   @id @default(uuid())
  name     String?
  jobs     Job[]
}

model Job {
  id          String   @id @default(uuid())
  name        String
  description String
  status      EJobStatus
  user        User     @relation(fields: [userId], references: [id])
  userId      String
}

enum EWorkerStatus {
	ONLINE
	OFFLINE
	WORKING
}

model Worker {
  id       String   @id @default(uuid())
  name     String?
  status   EWorkerStatus
}