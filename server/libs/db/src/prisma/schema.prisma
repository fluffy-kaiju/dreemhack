// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id       String   @id @default(uuid())
  name     String?
  jobs     Job[]
}


enum EJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum EJobType {
	NMAP_SCAN_PORTS
	NMAP_SCAN_NETWORK

	SUBDOMAIN_SCAN
}

model Job {
  id          String   @id @default(uuid())
  name        String
  description String
  status      EJobStatus

  type        EJobType
  // To avoid multiple relations type for each job type we store the raw result.
  // The Master will have to parse the result, depending on the job type, and store it in the right table.
  //   Like for a SUBDOMAIN_SCAN job:
  //    - Store all subdomains names in a Subdomain table
  //    - Store all subdomains IPs in a SubdomainIP table and link them to the Subdomain table
  //    - Store all subdomains IPs open ports in a SubdomainIPOpenPort table and link them to the SubdomainIP table
  rawResult   String?

  user        User     @relation(fields: [userId], references: [id])
  userId      String

  subdomains  Subdomain[]
  IPs  IP[]
  Ports  Port[]
}

model Subdomain {
  id       String   @id @default(uuid())
  name     String

  subdomainIP  IP[]

  job       Job @relation(fields: [jobId], references: [id])
  jobId     String
}

model IP {
  id       String   @id @default(uuid())
  ipv4       String?
  ipv6       String?

  subdomain  Subdomain[]
  ports  Port[]

  job       Job @relation(fields: [jobId], references: [id])
  jobId     String
}

model Port {
  id       String   @id @default(uuid())
  port     Int

  ip       IP @relation(fields: [ipId], references: [id])
  ipId     String

  job       Job @relation(fields: [jobId], references: [id])
  jobId     String
}

enum EWorkerStatus {
	ONLINE
	OFFLINE
	WORKING
}

model Worker {
  id       String   @id @default(uuid())
  status   EWorkerStatus

}
